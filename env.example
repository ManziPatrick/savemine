# Database
MONGODB_URI=mongodb://localhost:27017/smartmoney
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Mista SMS/WhatsApp API
# You only need to set MISTA_API_TOKEN (or use MISTA_API_KEY if preferred)
# Get your token from: https://mista.io or https://dashboard.mista.io
MISTA_API_URL=https://api.mista.io
MISTA_API_TOKEN=your_mista_api_token_here
# Alternative variable names (use any one):
# MISTA_API_KEY=your_mista_api_token_here
# SMS_API_TOKEN=your_mista_api_token_here

# Sender ID (optional - defaults to "FinController")
MISTA_SENDER_ID=FinController
SMS_SENDER_NAME=FinController

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Groq AI Assistant (chatbot that fills forms + generates reports)
# Get your key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Hugging Face AI (second provider - shares load with Groq to manage tokens)
# Get a token from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_huggingface_token_here
HF_MODEL=openai/gpt-oss-120b
# AI provider strategy: fallback (Groq first, HF on error) | round_robin | groq | huggingface
AI_PROVIDER_STRATEGY=fallback

# Pindo SMS (second messaging method - automatic fallback after Mista)
# Get your token from: https://pindo.io (Profile -> Security)
PINDO_API_URL=https://api.pindo.io
PINDO_API_TOKEN=your_pindo_token_here
PINDO_SENDER_ID=PindoTest

# Email Configuration (for future use)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@fincontroller.com

# AWS S3 Configuration (optional for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log


