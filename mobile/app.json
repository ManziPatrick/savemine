{
  "expo": {
    "name": "SmartMoney FRW",
    "slug": "smartmoney-frw",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#059669"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartmoney.frw",
      "infoPlist": {
        "NSContactsUsageDescription": "This app needs access to your contacts to select contacts for loans and transactions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.smartmoney.frw",
      "permissions": [
        "NOTIFICATIONS",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_CONTACTS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "versionCode": 1
    },
    "web": {},
    "plugins": [
      "expo-notifications",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow SmartMoney to access your contacts to select contacts for loans and transactions."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3217b0d1-8418-405f-97d6-491cee95f6de"
      }
    }
  }
}
