{
  "info": {
    "name": "SmartMoney FRW API",
    "description": "Comprehensive financial management API with SMS/WhatsApp reminders",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"+250788123456\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('auth_token', response.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('auth_token', response.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Loans",
      "item": [
        {
          "name": "Get All Loans",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/loans?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["loans"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Create Loan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contactId\": \"{{contact_id}}\",\n  \"amount\": 100000,\n  \"currency\": \"FRW\",\n  \"givenDate\": \"2024-01-01\",\n  \"dueDate\": \"2024-02-01\",\n  \"interestRate\": 5,\n  \"description\": \"Business loan for inventory\",\n  \"notes\": \"30-day loan\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/loans",
              "host": ["{{base_url}}"],
              "path": ["loans"]
            }
          }
        },
        {
          "name": "Get Outstanding Loans",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/loans/outstanding",
              "host": ["{{base_url}}"],
              "path": ["loans", "outstanding"]
            }
          }
        },
        {
          "name": "Pay Loan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100000,\n  \"notes\": \"Full payment\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/loans/{{loan_id}}/pay",
              "host": ["{{base_url}}"],
              "path": ["loans", "{{loan_id}}", "pay"]
            }
          }
        }
      ]
    },
    {
      "name": "Contacts",
      "item": [
        {
          "name": "Get All Contacts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/contacts?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["contacts"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Create Contact",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Mukamana\",\n  \"phone\": \"+250788111222\",\n  \"type\": \"debtor\",\n  \"email\": \"alice@example.com\",\n  \"address\": \"Kigali, Rwanda\",\n  \"notes\": \"Regular customer\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/contacts",
              "host": ["{{base_url}}"],
              "path": ["contacts"]
            }
          }
        }
      ]
    },
    {
      "name": "Reminders",
      "item": [
        {
          "name": "Get All Reminders",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/reminders?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["reminders"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Create Reminder",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"modelType\": \"loan\",\n  \"modelId\": \"{{loan_id}}\",\n  \"title\": \"Loan Payment Reminder\",\n  \"sendAt\": \"2024-01-28T10:00:00Z\",\n  \"messageTemplate\": \"Hi {contactName}, your loan of {amount} FRW is due on {dueDate}. Please ensure payment.\",\n  \"autoSend\": true,\n  \"channels\": [\"sms\", \"whatsapp\"],\n  \"priority\": \"high\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/reminders",
              "host": ["{{base_url}}"],
              "path": ["reminders"]
            }
          }
        },
        {
          "name": "Send Reminder Now",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/reminders/{{reminder_id}}/send-now",
              "host": ["{{base_url}}"],
              "path": ["reminders", "{{reminder_id}}", "send-now"]
            }
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Get All Transactions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/transactions?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["transactions"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Create Transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"income\",\n  \"amount\": 150000,\n  \"category\": \"Salary\",\n  \"date\": \"2024-01-15\",\n  \"description\": \"Monthly salary payment\",\n  \"notes\": \"Regular income\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/transactions",
              "host": ["{{base_url}}"],
              "path": ["transactions"]
            }
          }
        }
      ]
    }
  ]
}


